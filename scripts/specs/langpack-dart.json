[
  {
    "id": "dart-command-injection",
    "group": "security",
    "languages": ["dart"],
    "severity": "ERROR",
    "category": "security:code-execution",
    "message": "Process spawned with a command taken from user-controlled data",
    "fix": "Use a fixed executable and pass user data as arguments",
    "either": ["Process.run($CMD", "Process.start($CMD"],
    "mvr": { "CMD": "[Uu]ser|[Ii]nput|[Aa]rgs|[Pp]arams?|[Qq]uery" },
    "metadata": { "owasp": "A03:2021-Injection", "cwe": "CWE-78", "confidence": "HIGH" },
    "fail": "final r = Process.run(userCmd, []);",
    "pass": "final r = Process.run('git', ['status']);"
  },
  {
    "id": "dart-spawn-uri",
    "group": "security",
    "languages": ["dart"],
    "severity": "ERROR",
    "category": "security:code-execution",
    "message": "Isolate spawned from a URI derived from user-controlled data",
    "fix": "Load only bundled entrypoints; never spawn code from request data",
    "pattern": "Isolate.spawnUri($URI",
    "mvr": { "URI": "[Uu]ser|[Ii]nput|[Qq]uery|[Pp]aram|[Rr]equest" },
    "metadata": { "owasp": "A08:2021-Integrity-Failure", "cwe": "CWE-94", "confidence": "HIGH" },
    "fail": "Isolate.spawnUri(Uri.parse(userScriptUrl), [], onExit);",
    "pass": "Isolate.spawnUri(Uri.file(entrypoint), [], onExit);"
  },
