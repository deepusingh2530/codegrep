    "id": "py-hmac-weak-digest",
    "languages": ["python"],
    "severity": "WARNING",
    "category": "security:weak-crypto",
    "message": "HMAC built with MD5 or SHA1 (weak digest)",
    "fix": "Use hashlib.sha256 or stronger as the digest",
    "pattern": "hmac.new($KEY, $MSG, $DIG)",
    "mvr": {"DIG": "(?i)md5|sha1"},
    "metadata": {"owasp": "A02:2021-Crypto-Failures", "cwe": "CWE-327", "confidence": "HIGH"},
    "group": "pyx5",
    "fail": "sig = hmac.new(key, msg, hashlib.md5)\n",
    "pass": "sig = hmac.new(key, msg, hashlib.sha256)\n"
  },
