  "metadata": {
   "owasp": "A07:2021-Identification-Auth",
   "cwe": "CWE-798",
   "confidence": "HIGH"
  },
  "group": "ygap3",
  "fail": "admin_password: admin",
  "pass": "admin_password: ${GRAFANA_ADMIN_PASSWORD}"
 },
