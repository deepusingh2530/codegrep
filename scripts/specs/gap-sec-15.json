 {
  "id": "yaml-gha-expression-in-run",
  "languages": [
   "yaml"
  ],
  "severity": "WARNING",
  "category": "security:code-execution",
  "message": "Workflow interpolates a ${{ }} expression into a run step (script injection)",
  "fix": "Pass the value via env: and quote it in the shell script",
  "pattern": "run: ${{",
  "metadata": {
   "owasp": "A03:2021-Injection",
   "cwe": "CWE-94",
   "confidence": "MEDIUM"
  },
  "group": "ygap3",
  "fail": "steps:\n  - name: comment\n    run: ${{ github.event.issue.title }}\n",
  "pass": "steps:\n  - name: build\n    run: make ci\n"
 },
 {
