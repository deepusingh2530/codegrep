[
 {
  "id": "yaml-k8s-hostport",
  "languages": [
   "yaml"
  ],
  "severity": "WARNING",
  "category": "security:misconfig",
  "message": "Container binds a hostPort (bypasses network policy)",
  "fix": "Use a Service instead of hostPort",
  "pattern": "hostPort:",
  "metadata": {
   "owasp": "A05:2021-Misconfiguration",
   "cwe": "CWE-284",
   "confidence": "HIGH"
  },
  "group": "ygap3",
  "fail": "containers:\n  - name: web\n    ports:\n      - containerPort: 80\n        hostPort: 80\n",
  "pass": "containers:\n  - name: web\n    ports:\n      - containerPort: 80\n"
 },
