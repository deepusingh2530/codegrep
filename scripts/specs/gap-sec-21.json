[
  {
    "id": "tf-random-password-short",
    "languages": ["terraform"],
    "severity": "WARNING",
    "category": "security:misconfig",
    "message": "random_password generates a very short password",
    "fix": "Use length >= 16 (or num_bytes >= 32)",
    "either": [
      "random_password ... length = 6",
      "random_password ... length = 8",
      "random_password ... length = 10",
      "random_password ... num_bytes = 8"
    ],
    "metadata": {"owasp": "A07:2021-Identification-Auth", "cwe": "CWE-521", "confidence": "HIGH"},
    "group": "tfgap3",
    "fail": "resource \"random_password\" \"db\" {\n  length = 8\n}\n",
    "pass": "resource \"random_password\" \"db\" {\n  length = 24\n}\n"
  },
