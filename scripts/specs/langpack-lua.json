[
  {
    "id": "lua-code-eval",
    "group": "security",
    "languages": ["lua"],
    "severity": "ERROR",
    "category": "security:code-execution",
    "message": "Lua chunk compiled/executed from user-controlled content",
    "fix": "Never load request data; use fixed chunks or data-driven dispatch",
    "either": ["load($C", "loadstring($C"],
    "mvr": { "C": "[Uu]ser|[Ii]nput|[Ff]ormat|[Qq]uery|[Pp]aram|[Rr]equest" },
    "metadata": { "owasp": "A03:2021-Injection", "cwe": "CWE-94", "confidence": "HIGH" },
    "fail": "local f = load(userInput)",
    "pass": "local f = load(fixedChunk)"
  },
  {
    "id": "lua-command-injection",
    "group": "security",
    "languages": ["lua"],
    "severity": "ERROR",
    "category": "security:code-execution",
    "message": "Shell command built from user-controlled data",
    "fix": "Use a fixed command; pass user data as separate arguments",
    "pattern": "os.execute($CMD",
    "mvr": { "CMD": "[Uu]ser|[Ii]nput|[Aa]rgs|[Pp]arams?|[Qq]uery" },
    "metadata": { "owasp": "A03:2021-Injection", "cwe": "CWE-78", "confidence": "HIGH" },
    "fail": "os.execute(\"rm -rf \" .. userDir)",
    "pass": "os.execute(\"ls -la /tmp\")"
  },
  {
    "id": "lua-path-traversal",
    "group": "security",
    "languages": ["lua"],
    "severity": "ERROR",
    "category": "security:path-traversal",
    "message": "File opened with a path derived from user-controlled data",
    "fix": "Canonicalize the path and confirm it stays inside the base directory",
    "pattern": "io.open($P",
    "mvr": { "P": "[Uu]ser|[Ii]nput|[Qq]uery|[Pp]aram|\\.\\./" },
    "metadata": { "owasp": "A01:2021-Broken-Access-Control", "cwe": "CWE-22", "confidence": "HIGH" },
    "fail": "local fh = io.open(\"../\" .. userFile)",
    "pass": "local fh = io.open(\"/etc/app.conf\")"
  },
  {
    "id": "lua-library-load",
    "group": "security",
    "languages": ["lua"],
    "severity": "ERROR",
    "category": "security:misconfig",
    "message": "Native library loaded from a user-controlled path (library injection)",
    "fix": "Load only fixed, trusted library paths",
    "pattern": "package.loadlib($L",
    "mvr": { "L": "[Uu]ser|[Ii]nput|[Qq]uery|[Pp]aram|\\.\\./" },
    "metadata": { "owasp": "A05:2021-Security-Misconfiguration", "cwe": "CWE-114", "confidence": "HIGH" },
    "fail": "package.loadlib(userLib, \"init\")",
    "pass": "package.loadlib(\"/usr/lib/lua/sock.so\", \"init\")"
  },
  {
    "id": "lua-ssrf-user-input",
    "group": "security",
    "languages": ["lua"],
    "severity": "ERROR",
    "category": "security:owasp-a10-ssrf",
    "message": "HTTP request URL taken from user-controlled data (SSRF)",
    "fix": "Validate the URL against an allowlist of hosts/schemes",
    "either": ["http.get($URL", "http.request($URL"],
    "mvr": { "URL": "[Uu]ser|[Ii]nput|[Qq]uery|[Pp]aram|[Rr]equest|[Nn]ext" },
    "metadata": { "owasp": "A10:2021-Server-Side-Request-Forgery", "cwe": "CWE-918", "confidence": "HIGH" },
    "fail": "http.get(userUrl)",
    "pass": "http.get(\"https://api.example.com/v1\")"
  },
  {
    "id": "lua-html-user-input",
    "group": "security",
    "languages": ["lua"],
    "severity": "WARNING",
    "category": "security:owasp-a3-xss",
    "message": "HTML written from user-controlled data (XSS)",
    "fix": "Escape user content before writing it to the response body",
    "pattern": "ngx.say($H",
    "mvr": { "H": "[Ff]ormat|[Uu]ser|[Ii]nput|[Rr]equest|[Qq]uery|[Pp]aram" },
    "metadata": { "owasp": "A03:2021-Injection", "cwe": "CWE-79", "confidence": "HIGH" },
    "fail": "ngx.say(\"<p>\", userBio)",
    "pass": "ngx.say(\"<p>Welcome</p>\")"
  },
  {
    "id": "lua-sql-concat",
    "group": "security",
    "languages": ["lua"],
    "severity": "ERROR",
    "category": "security:owasp-a1-injection",
    "message": "SQL built by concatenation (SQL injection)",
    "fix": "Use parameterized queries instead of concatenating SQL",
    "either": ["conn:query($Q", "db:query($Q"],
    "mvr": { "Q": "[Ff]ormat|[Uu]ser|[Ii]nput|[Pp]aram|\\.\\." },
    "metadata": { "owasp": "A03:2021-Injection", "cwe": "CWE-89", "confidence": "HIGH" },
    "fail": "local res = conn:query(\"SELECT * FROM users WHERE id=\" .. uid)",
    "pass": "local res = conn:query(\"SELECT * FROM accounts WHERE id = ?\", {uid})"
  },
  {
    "id": "lua-weak-md5-sha1",
    "group": "security",
    "languages": ["lua"],
    "severity": "WARNING",
    "category": "security:weak-crypto",
    "message": "MD5/SHA-1 hash used (broken for security purposes)",
    "fix": "Use SHA-256+ for integrity, bcrypt/scrypt/argon2 for passwords",
    "either": ["md5.sumhexa(", "md5.sum("],
    "metadata": { "owasp": "A02:2021-Crypto-Failures", "cwe": "CWE-327", "confidence": "MEDIUM" },
    "fail": "local h = md5.sumhexa(data)",
    "pass": "local h = sha256.hex(data)"
  }
