[
  {
    "id": "c-malloc-size-overflow",
    "group": "gap1",
    "languages": [
      "c"
    ],
    "severity": "WARNING",
    "category": "security:owasp-a1-injection",
    "message": "Allocation size is a product of two variables (integer overflow can under-allocate)",
    "fix": "Check multiplication for overflow or use a checked-alloc helper",
    "either": [
      "malloc($N * $S)",
      "realloc($PTR, $N * $S)"
    ],
    "metadata": {
      "owasp": "A03:2021-Injection",
      "cwe": "CWE-190",
      "confidence": "MEDIUM"
    },
    "fail": "p = malloc(count * size);",
    "pass": "p = malloc(count);"
  },
