  {
    "id": "c-off-by-one-loop",
    "group": "gap1",
    "languages": [
      "c"
    ],
    "severity": "WARNING",
    "category": "security:owasp-a1-injection",
    "message": "Loop uses <= while indexing an array (classic off-by-one out-of-bounds)",
    "fix": "Use < with the length, or ensure capacity is length + 1",
    "pattern": "for (... <= $N; ...) ... $ARR[...]",
    "metadata": {
      "owasp": "A03:2021-Injection",
      "cwe": "CWE-787",
      "confidence": "MEDIUM"
    },
    "fail": "for (i = 0; i <= len; i++) { out[i] = buf[i]; }",
    "pass": "for (i = 0; i < len; i++) { out[i] = buf[i]; }"
  },
