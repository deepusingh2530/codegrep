 {
  "id": "c-gets-buffer-overflow",
  "group": "security",
  "languages": [
   "c"
  ],
  "severity": "ERROR",
  "category": "security:owasp-a1-injection",
  "message": "gets() cannot bound input length and overflows the buffer",
  "fix": "Use fgets(buf, sizeof(buf), stdin)",
  "pattern": "gets($BUF)",
  "not": "fgets",
  "metadata": {
   "owasp": "A03:2021-Injection",
   "cwe": "CWE-120",
   "confidence": "HIGH"
  },
  "fail": "char line[64];\ngets(line);\n",
  "pass": "char line[64];\nif (fgets(line, sizeof(line), stdin) == NULL) return -1;\n"
 },
 {
  "id": "c-strcpy-unbounded",
  "group": "security",
  "languages": [
   "c"
  ],
  "severity": "WARNING",
  "category": "security:owasp-a1-injection",
  "message": "strcpy copies without bounds checking",
  "fix": "Use strncpy or strlcpy with an explicit size",
  "pattern": "strcpy($DST, $SRC)",
  "metadata": {
   "owasp": "A03:2021-Injection",
   "cwe": "CWE-120",
   "confidence": "HIGH"
  },
  "fail": "char dst[16];\nstrcpy(dst, src);\n",
  "pass": "char dst[16];\nstrncpy(dst, src, sizeof(dst) - 1);\n"
 },
 {
  "id": "c-sprintf-buffer-overflow",
  "group": "security",
  "languages": [
   "c"
  ],
  "severity": "WARNING",
  "category": "security:owasp-a1-injection",
  "message": "sprintf may overflow its destination buffer",
  "fix": "Use snprintf with an explicit size",
  "pattern": "sprintf($BUF, ...)",
  "metadata": {
   "owasp": "A03:2021-Injection",
   "cwe": "CWE-787",
   "confidence": "MEDIUM"
  },
  "fail": "char buf[32];\nsprintf(buf, \"%s\", name);\n",
  "pass": "char buf[32];\nsnprintf(buf, sizeof(buf), \"%s\", name);\n"
 },
 {
  "id": "c-system-command-injection",
  "group": "security",
  "languages": [
   "c"
  ],
  "severity": "ERROR",
  "category": "security:owasp-a1-injection",
  "message": "system() invokes a shell and enables command injection",
  "fix": "Avoid the shell; use execve with a fixed argument vector",
  "pattern": "system($CMD)",
  "metadata": {
   "owasp": "A03:2021-Injection",
   "cwe": "CWE-78",
   "confidence": "HIGH"
  },
  "fail": "char cmd[128];\nsystem(cmd);\n",
  "pass": "pid_t p = fork();\nif (p == 0) execl(\"/bin/ls\", \"ls\", NULL);\n"
 },
 {
  "id": "c-printf-user-format",
  "group": "security",
  "languages": [
   "c"
  ],
  "severity": "WARNING",
  "category": "security:owasp-a1-injection",
  "message": "printf uses user data as the format string",
  "fix": "Pass a constant format: printf(\"%s\", user_input)",
  "pattern": "printf($FMT)",
  "not": "printf(\"",
  "metadata": {
   "owasp": "A03:2021-Injection",
   "cwe": "CWE-134",
   "confidence": "MEDIUM"
  },
  "fail": "char name[64];\nprintf(name);\n",
  "pass": "char name[64];\nprintf(\"%s\", name);\n"
 },
