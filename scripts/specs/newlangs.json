[
 {
  "id": "tf-s3-public-acl",
  "group": "security",
  "languages": [
   "terraform"
  ],
  "severity": "WARNING",
  "category": "security:misconfig",
  "message": "S3 bucket ACL grants public read access",
  "fix": "Set bucket ACL to private and use presigned URLs or a CDN for public assets",
  "pattern": "acl = \"public-read\"",
  "metadata": {
   "owasp": "A01:2021-Broken-Access-Control",
   "cwe": "CWE-732",
   "confidence": "MEDIUM"
  },
  "fail": "resource \"aws_s3_bucket\" \"data\" {\n  bucket = \"company-data\"\n  acl    = \"public-read\"\n}",
  "pass": "resource \"aws_s3_bucket\" \"data\" {\n  bucket = \"company-data\"\n  acl    = \"private\"\n}"
 },
