 {
  "id": "docker-curl-pipe-shell",
  "group": "security",
  "languages": [
   "dockerfile"
  ],
  "severity": "WARNING",
  "category": "security:code-execution",
  "message": "Pipes a remote script directly into a shell during build",
  "fix": "Download, verify a checksum/signature, then execute",
  "pattern": "| sh",
  "metadata": {
   "owasp": "A08:2021-Integrity-Failure",
   "cwe": "CWE-494",
   "confidence": "MEDIUM"
  },
  "fail": "FROM alpine:3.19\nRUN curl -fsSL https://example.sh | sh\n",
  "pass": "FROM alpine:3.19\nRUN curl -fsSL https://pkg.example.tar.gz -o pkg.tgz\n"
 },
 {
