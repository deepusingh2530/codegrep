[
  {
    "id": "java-secret-key-spec-literal",
    "languages": ["java"],
    "severity": "ERROR",
    "category": "security:secrets",
    "message": "SecretKeySpec created from a string literal",
    "fix": "Load the key from a KMS or secret manager at runtime",
    "pattern": "SecretKeySpec(\"",
    "metadata": {"owasp": "A07:2021-Identification-Auth", "cwe": "CWE-798", "confidence": "HIGH"},
    "group": "jvx5",
    "fail": "SecretKeySpec key = new SecretKeySpec(\"0123456789abcdef\".getBytes(), \"AES\");",
    "pass": "SecretKeySpec key = new SecretKeySpec(userKeyBytes, \"AES\");"
  },
  {
    "id": "java-tls-legacy-protocols",
    "languages": ["java"],
    "severity": "WARNING",
    "category": "security:owasp-a2-crypto",
    "message": "Obsolete SSL/TLS protocol enabled (TLSv1/TLSv1.1/SSLv3)",
    "fix": "Enable only TLSv1.2+ protocols",
    "either": ["\"TLSv1\"", "\"TLSv1.1\"", "\"SSLv3\""],
    "metadata": {"owasp": "A02:2021-Crypto-Failures", "cwe": "CWE-327", "confidence": "MEDIUM"},
    "group": "jvx5",
    "fail": "ssl.setEnabledProtocols(new String[]{\"TLSv1\", \"TLSv1.2\"});",
    "pass": "ssl.setEnabledProtocols(new String[]{\"TLSv1.2\", \"TLSv1.3\"});"
  },
  {
    "id": "java-weak-rsa-keygen",
    "languages": ["java"],
    "severity": "WARNING",
    "category": "security:weak-crypto",
    "message": "RSA/DH key generated with <2048-bit modulus",
    "fix": "Generate 2048-bit or larger keys",
    "either": ["RSAKeyGenParameterSpec(1024", ".initialize(1024"],
    "metadata": {"owasp": "A02:2021-Crypto-Failures", "cwe": "CWE-327", "confidence": "MEDIUM"},
    "group": "jvx5",
    "fail": "kpg.initialize(1024);",
    "pass": "kpg.initialize(2048);"
  },
  {
    "id": "java-mysql-use-ssl-false",
    "languages": ["java"],
    "severity": "WARNING",
    "category": "security:owasp-a2-crypto",
    "message": "MySQL JDBC connection with TLS disabled (useSSL=false)",
    "fix": "Require TLS and verify server certificates",
    "pattern": "useSSL=false",
    "metadata": {"owasp": "A02:2021-Crypto-Failures", "cwe": "CWE-319", "confidence": "MEDIUM"},
    "group": "jvx5",
    "fail": "String url = \"jdbc:mysql://db.example.com/app?useSSL=false\";",
    "pass": "String url = \"jdbc:mysql://db.example.com/app?useSSL=true\";"
  },
  {
    "id": "go-rand-seed",
    "languages": ["go"],
    "severity": "WARNING",
    "category": "security:weak-crypto",
    "message": "math/rand seeded deterministically (predictable output)",
    "fix": "Use crypto/rand for security-sensitive randomness",
    "either": ["rand.Seed(", "mrand.Seed("],
    "metadata": {"owasp": "A02:2021-Crypto-Failures", "cwe": "CWE-338", "confidence": "MEDIUM"},
    "group": "gox4",
    "fail": "rand.Seed(time.Now().UnixNano())",
    "pass": "n, err := rand.Int(rand.Reader, big.NewInt(100))\n"
  },
  {
    "id": "go-mongo-nosqli",
    "languages": ["go"],
    "severity": "ERROR",
    "category": "security:owasp-a1-injection",
    "message": "MongoDB operator expression from untrusted input (NoSQL injection)",
    "fix": "Use typed operator expressions instead of $where/$regex",
    "pattern": "\"$OP\"",
    "mvr": {"OP": "^(\\$where|\\$regex|\\$function)$"},
    "metadata": {"owasp": "A03:2021-Injection", "cwe": "CWE-943", "confidence": "HIGH"},
    "group": "gox4",
    "fail": "filter := bson.M{\"$where\": \"this.x == 1\"}",
    "pass": "filter := bson.M{\"name\": \"alice\"}\n"
  },
  {
    "id": "go-hardcoded-slack-token",
    "languages": ["go"],
    "severity": "WARNING",
    "category": "security:secrets",
    "message": "Hardcoded Slack API token",
    "fix": "Read the token from the environment",
    "either": [
      "$VAR = \"xoxb-$REST\"", "$VAR := \"xoxb-$REST\"", "$VAR: \"xoxb-$REST\"",
      "$VAR = \"xoxp-$REST\"", "$VAR := \"xoxp-$REST\"", "$VAR: \"xoxp-$REST\""
    ],
    "mvr": {"REST": "^[A-Za-z0-9_-]{20,}$"},
    "metadata": {"owasp": "A07:2021-Identification-Auth", "cwe": "CWE-798", "confidence": "HIGH"},
    "group": "gox4",
    "fail": "token := \"xoxb-1234567890-abcdefghijklmnopqrst\"",
    "pass": "token := os.Getenv(\"SLACK_TOKEN\")\n"
  },
  {
    "id": "go-hardcoded-npm-token",
    "languages": ["go"],
    "severity": "WARNING",
    "category": "security:secrets",
    "message": "Hardcoded npm automation token (npm_...)",
    "fix": "Read NPM_TOKEN from CI secrets",
    "either": [
      "$VAR = \"npm_$REST\"", "$VAR := \"npm_$REST\"", "$VAR: \"npm_$REST\""
    ],
    "mvr": {"REST": "^[A-Za-z0-9]{30,}$"},
    "metadata": {"owasp": "A07:2021-Identification-Auth", "cwe": "CWE-798", "confidence": "HIGH"},
    "group": "gox4",
    "fail": "tok := \"npm_abcdef1234567890abcdef123456789012\"",
    "pass": "tok := os.Getenv(\"NPM_TOKEN\")\n"
  },
  {
    "id": "go-hardcoded-salt",
    "languages": ["go"],
    "severity": "WARNING",
    "category": "security:weak-crypto",
    "message": "Hardcoded salt value",
    "fix": "Derive a unique salt per secret",
    "either": ["salt = \"", "salt := \"", "salt: \""],
    "metadata": {"owasp": "A02:2021-Crypto-Failures", "cwe": "CWE-760", "confidence": "MEDIUM"},
    "group": "gox4",
    "fail": "salt := \"pepper123\"",
    "pass": "salt, err := generateSalt()\n"
