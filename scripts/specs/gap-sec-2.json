[
  {
    "id": "py-marshal-load",
    "group": "pygap1",
    "languages": ["python"],
    "severity": "ERROR",
    "category": "security:deserialization",
    "message": "marshal.load deserializes untrusted data into arbitrary objects",
    "fix": "Use json or a safe format; never unmarshal untrusted input",
    "pattern": "marshal.load($F)",
    "metadata": {"owasp": "A08:2021-Integrity-Failure", "cwe": "CWE-502", "confidence": "HIGH"},
    "fail": "obj = marshal.load(f)",
    "pass": "obj = json.load(f)"
  },
  {
    "id": "py-xml-et-fromstring",
    "group": "pygap1",
    "languages": ["python"],
    "severity": "WARNING",
    "category": "security:xxe",
    "message": "ElementTree.fromstring parses XML that may resolve entities",
    "fix": "Use defusedxml.ElementTree or disable entity resolution",
    "either": ["ET.fromstring($X)", "ElementTree.fromstring($X)"],
    "mvr": {"X": "^[^\"']"},
    "metadata": {"owasp": "A03:2021-Injection", "cwe": "CWE-611", "confidence": "MEDIUM"},
    "fail": "root = ET.fromstring(untrusted_xml)",
    "pass": "root = ET.fromstring(\"<root/>\")"
  },
  {
    "id": "py-pbkdf2-low-iterations",
    "group": "pygap1",
    "languages": ["python"],
    "severity": "ERROR",
    "category": "security:weak-crypto",
    "message": "PBKDF2 iteration count is far below current guidance (<=9999)",
    "fix": "Use at least 600000 iterations (OWASP 2023) for PBKDF2-HMAC-SHA256",
    "pattern": "hashlib.pbkdf2_hmac($ARGS)",
    "mvr": {"ARGS": ",\\s*\\d{1,4}$"},
    "metadata": {"owasp": "A02:2021-Crypto-Failures", "cwe": "CWE-916", "confidence": "HIGH"},
    "fail": "dk = hashlib.pbkdf2_hmac(\"sha256\", pw, salt, 1000)",
    "pass": "dk = hashlib.pbkdf2_hmac(\"sha256\", pw, salt, 600000)"
  },
  {
    "id": "py-django-secure-settings-off",
    "group": "pygap1",
    "languages": ["python"],
    "severity": "WARNING",
    "category": "security:misconfig",
    "message": "Django secure-cookie / HTTPS-redirect setting disabled",
    "fix": "Set SESSION_COOKIE_SECURE, CSRF_COOKIE_SECURE and SECURE_SSL_REDIRECT to True in production",
    "either": [
      "SESSION_COOKIE_SECURE = False",
      "CSRF_COOKIE_SECURE = False",
      "SECURE_SSL_REDIRECT = False"
    ],
    "metadata": {"owasp": "A02:2021-Crypto-Failures", "cwe": "CWE-319", "confidence": "HIGH"},
    "fail": "SESSION_COOKIE_SECURE = False",
    "pass": "SESSION_COOKIE_SECURE = True"
  },
  {
    "id": "py-django-cors-wildcard",
    "group": "pygap1",
    "languages": ["python"],
    "severity": "ERROR",
    "category": "security:misconfig",
    "message": "CORS configured to allow any origin",
    "fix": "Allowlist the exact origins that may call the API",
    "either": ["CORS_ALLOW_ALL_ORIGINS = True", "CORS_ALLOW_ALL = True"],
    "metadata": {"owasp": "A05:2021-Misconfiguration", "cwe": "CWE-942", "confidence": "HIGH"},
    "fail": "CORS_ALLOW_ALL_ORIGINS = True",
    "pass": "CORS_ALLOWED_ORIGINS = [\"https://app.example.com\"]"
  },
  {
    "id": "py-mass-assignment",
    "group": "pygap1",
    "languages": ["python"],
    "severity": "ERROR",
    "category": "security:owasp-a1-injection",
    "message": "Object created directly from request data (mass assignment)",
    "fix": "Pass an explicit field allowlist instead of unpacking request data",
    "pattern": "create(**$DATA)",
    "mvr": {"DATA": "^request\\."},
    "metadata": {"owasp": "A03:2021-Injection", "cwe": "CWE-915", "confidence": "HIGH"},
    "fail": "User.objects.create(**request.POST)",
    "pass": "User.objects.create(**validated_data)"
  },
  {
    "id": "py-redos-user-pattern",
    "group": "pygap1",
    "languages": ["python"],
    "severity": "WARNING",
    "category": "security:denial-of-service",
    "message": "Regex built from request input (ReDoS via catastrophic backtracking)",
    "fix": "Constrain the pattern, cap input length, or use a linear-time engine",
    "either": ["re.match($PAT, $S)", "re.search($PAT, $S)", "re.compile($PAT)"],
    "mvr": {"PAT": "^request\\.|^req\\."},
    "metadata": {"owasp": "A04:2021-Insecure-Design", "cwe": "CWE-1333", "confidence": "MEDIUM"},
    "fail": "m = re.match(request.args.get(\"p\"), value)",
    "pass": "m = re.match(r\"^\\d+$\", value)"
  },
  {
    "id": "py-weak-random-choices",
    "group": "pygap1",
    "languages": ["python"],
    "severity": "WARNING",
    "category": "security:weak-crypto",
    "message": "Non-cryptographic RNG used for choice/shuffle/sample",
    "fix": "Use the secrets module for anything security-relevant",
    "either": [
      "random.choice($SEQ)",
      "random.shuffle($L)",
      "random.sample($POP, $K)",
      "random.randrange($N)"
    ],
    "metadata": {"owasp": "A02:2021-Crypto-Failures", "cwe": "CWE-338", "confidence": "MEDIUM"},
    "fail": "token = random.choice(alphabet)",
    "pass": "token = secrets.choice(alphabet)"
  },
  {
    "id": "py-redirect-user-input",
    "group": "pygap1",
    "languages": ["python"],
    "severity": "ERROR",
    "category": "security:open-redirect",
    "message": "Redirect target taken from request input (open redirect)",
    "fix": "Map the parameter to an allowlist of local destinations",
    "pattern": "redirect($URL)",
    "mvr": {"URL": "^(request\\.|\\$_)"},
    "metadata": {"owasp": "A01:2021-Broken-Access-Control", "cwe": "CWE-601", "confidence": "HIGH"},
    "fail": "return redirect(request.args.get(\"next\"))",
    "pass": "return redirect(\"/dashboard\")"
  },
  {
    "id": "py-xmlrpc-ssrf",
    "group": "pygap1",
    "languages": ["python"],
    "severity": "WARNING",
    "category": "security:owasp-a10-ssrf",
    "message": "xmlrpc ServerProxy points at a computed endpoint (SSRF)",
    "fix": "Pin the endpoint to a constant, allowlisted URL",
    "pattern": "xmlrpc.client.ServerProxy($URL)",
    "mvr": {"URL": "^[^\"']"},
    "metadata": {"owasp": "A10:2021-SSRF", "cwe": "CWE-918", "confidence": "MEDIUM"},
    "fail": "proxy = xmlrpc.client.ServerProxy(user_supplied_url)",
    "pass": "proxy = xmlrpc.client.ServerProxy(\"https://api.example.com/rpc\")"
  },
  {
    "id": "py-debugger-trace",
    "group": "pygap1",
    "languages": ["python"],
    "severity": "INFO",
    "category": "security:misconfig",
    "message": "Debugger breakpoint left in source",
    "fix": "Remove the breakpoint before committing",
    "either": ["pdb.set_trace()", "breakpoint()"],
