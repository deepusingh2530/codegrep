    "fail": "pdb.set_trace()",
    "pass": "logger.debug(\"entering handler\")"
  },
  {
    "id": "py-sqlite-conn-execute",
    "group": "pygap1",
    "languages": ["python"],
    "severity": "WARNING",
    "category": "security:sqli",
    "message": "SQLite execute called with a dynamically built statement",
    "fix": "Use parameter binding: execute(\"... WHERE id = ?\", (value,))",
    "either": ["conn.execute($Q)", "connection.execute($Q)"],
    "mvr": {"Q": "^f\"|^[A-Za-z_][\\w.]*$"},
    "metadata": {"owasp": "A03:2021-Injection", "cwe": "CWE-89", "confidence": "MEDIUM"},
    "fail": "row = conn.execute(f\"SELECT * FROM users WHERE n = '{name}'\")",
    "pass": "row = conn.execute(\"SELECT * FROM users WHERE id = ?\", (uid,))"
  },
  {
    "id": "js-require-user-input",
    "group": "jsgap1",
    "languages": ["javascript"],
    "severity": "ERROR",
    "category": "security:code-execution",
    "message": "require() loads a module path from request input",
    "fix": "Map input to a fixed set of module names",
    "pattern": "require($MOD)",
    "mvr": {"MOD": "^(req\\.|request\\.|[A-Za-z_$][A-Za-z0-9_$]*\\s*\\+)"},
    "metadata": {"owasp": "A03:2021-Injection", "cwe": "CWE-94", "confidence": "HIGH"},
    "fail": "const m = require(req.query.mod);",
    "pass": "const e = require(\"express\");"
  },
  {
    "id": "js-dynamic-import-user",
    "group": "jsgap1",
    "languages": ["javascript"],
    "severity": "ERROR",
    "category": "security:code-execution",
    "message": "Dynamic import() resolves a module path from request input",
    "fix": "Map input to a fixed set of module names",
    "pattern": "import($SRC)",
    "mvr": {"SRC": "^(req\\.|request\\.|[A-Za-z_$][A-Za-z0-9_$]*\\s*\\+)"},
    "metadata": {"owasp": "A03:2021-Injection", "cwe": "CWE-94", "confidence": "HIGH"},
    "fail": "const m = await import(req.query.mod);",
    "pass": "const m = await import(\"./mod.js\");"
  },
  {
    "id": "js-mysql-query",
    "group": "jsgap1",
    "languages": ["javascript"],
    "severity": "WARNING",
    "category": "security:sqli",
    "message": "SQL driver query() called with a dynamically built statement",
    "fix": "Use placeholder parameters instead of string building",
    "either": ["connection.query($Q)", "client.query($Q)", "pool.query($Q)"],
    "mvr": {"Q": "^`|^[A-Za-z_][\\w.]*$"},
    "metadata": {"owasp": "A03:2021-Injection", "cwe": "CWE-89", "confidence": "MEDIUM"},
    "fail": "const r = connection.query(`SELECT * FROM u WHERE n = '${name}'`);",
    "pass": "const r = connection.query(\"SELECT 1\");"
  },
  {
    "id": "js-writefile-dynamic-path",
    "group": "jsgap1",
    "languages": ["javascript"],
    "severity": "WARNING",
    "category": "security:path-traversal",
    "message": "fs write path built from concatenated or request-derived data",
    "fix": "Resolve the path and confine it under an allowlisted base directory",
    "either": ["fs.writeFile($P, $D)", "fs.writeFileSync($P, $D)"],
    "mvr": {"P": "\\+|req\\.|request\\."},
    "metadata": {"owasp": "A01:2021-Broken-Access-Control", "cwe": "CWE-22", "confidence": "MEDIUM"},
    "fail": "fs.writeFileSync(base + name, data);",
    "pass": "fs.writeFileSync(\"out.json\", data);"
  },
  {
    "id": "js-jquery-extend-deep",
    "group": "jsgap1",
    "languages": ["javascript"],
    "severity": "WARNING",
    "category": "security:prototype-pollution",
    "message": "jQuery deep extend merges objects (prototype pollution if source is untrusted)",
    "fix": "Validate keys or use a safe merge that skips __proto__/constructor",
    "pattern": "$.extend(true, $T, $S)",
    "metadata": {"owasp": "A08:2021-Integrity-Failure", "cwe": "CWE-1321", "confidence": "MEDIUM"},
    "fail": "$.extend(true, defaults, userInput);",
    "pass": "$.extend({}, defaults);"
  },
  {
    "id": "js-lodash-defaultsdeep",
    "group": "jsgap1",
    "languages": ["javascript"],
    "severity": "WARNING",
    "category": "security:prototype-pollution",
    "message": "defaultsDeep recursively merges objects (prototype pollution risk)",
    "fix": "Validate input keys or use a merge that blocks __proto__",
    "pattern": "defaultsDeep($A, $B)",
    "metadata": {"owasp": "A08:2021-Integrity-Failure", "cwe": "CWE-1321", "confidence": "HIGH"},
    "fail": "const o = _.defaultsDeep({}, JSON.parse(raw));",
    "pass": "const o = Object.assign({}, defaults);"
  },
  {
    "id": "js-lodash-set-path",
    "group": "jsgap1",
    "languages": ["javascript"],
    "severity": "ERROR",
    "category": "security:prototype-pollution",
    "message": "_.set() path taken from request input (__proto__ pollution)",
    "fix": "Allowlist path segments or reject __proto__/constructor keys",
    "pattern": "_.set($O, $PATH, $V)",
    "mvr": {"PATH": "^(req\\.|request\\.|\\$\\{)"},
