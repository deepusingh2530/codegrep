      "httpx.get($URL)",
      "httpx.post($URL)",
      "urlopen($URL)",
      "urlopen($URL, ..."
    ],
    "mvr": {
      "URL": "[Uu]ser|[Ii]nput|[Qq]uery|[Pp]aram|[Rr]eq|[Hh]ost|[Uu]rl"
    },
    "metadata": {
      "owasp": "A10:2021-Server-Side-Request-Forgery",
      "cwe": "CWE-918",
      "confidence": "MEDIUM"
    },
    "fail": "r = requests.get(f\"https://{request.args['host']}/health\")",
    "pass": "r = requests.get(\"https://api.internal.example/health\", timeout=5)"
  },
