    "id": "ts-jwt-ignore-expiration",
    "languages": ["typescript"],
    "severity": "WARNING",
    "category": "security:owasp-a2-crypto",
    "message": "JWT verification ignores expiration",
    "fix": "Remove ignoreExpiration so expired tokens are rejected",
    "pattern": "ignoreExpiration: true",
