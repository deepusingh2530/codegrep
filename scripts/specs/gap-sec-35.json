[
  {
    "id": "ts-hardcoded-aws-key",
    "languages": ["typescript"],
    "severity": "WARNING",
    "category": "security:secrets",
    "message": "Hardcoded AWS access key ID",
    "fix": "Read credentials from the environment/STS",
    "either": ["$VAR = \"AKIA$REST\"", "$VAR: \"AKIA$REST\""],
