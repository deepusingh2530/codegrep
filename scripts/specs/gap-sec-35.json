    "severity": "ERROR",
    "category": "security:owasp-a1-injection",
    "message": "SQL built by string concatenation",
    "fix": "Use parameterized queries with ? placeholders",
    "pattern": "\"SELECT * FROM $TABLE WHERE $COL=\" + $ID",
