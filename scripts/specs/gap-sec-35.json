    "pass": "const d = jwt.verify(t, secret, {ignoreExpiration: false});"
  },
  {
    "id": "ts-cookie-samesite-none",
    "languages": ["typescript"],
    "severity": "WARNING",
    "category": "security:misconfig",
    "message": "Cookie set with SameSite=None (CSRF exposure unless Secure)",
    "fix": "Use SameSite=Lax or SameSite=Strict with Secure",
    "either": ["sameSite: \"none\"", "sameSite: 'none'", "SameSite=None"],
