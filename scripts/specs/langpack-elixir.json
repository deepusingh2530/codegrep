[
  {
    "id": "elixir-command-injection",
    "group": "security",
    "languages": ["elixir"],
    "severity": "ERROR",
    "category": "security:code-execution",
    "message": "OS command run with an argument taken from user-controlled data",
    "fix": "Use a fixed command and pass user data as separate arguments",
    "either": ["System.cmd($CMD", ":os.cmd($CMD"],
    "mvr": { "CMD": "[Uu]ser|[Ii]nput|[Aa]rgs|[Pp]arams?|[Qq]uery" },
    "metadata": { "owasp": "A03:2021-Injection", "cwe": "CWE-78", "confidence": "HIGH" },
    "fail": "System.cmd(userProg, [\"-h\"])",
    "pass": "System.cmd(\"git\", [\"status\"])"
  },
  {
    "id": "elixir-code-eval",
    "group": "security",
    "languages": ["elixir"],
    "severity": "ERROR",
    "category": "security:code-execution",
    "message": "Elixir code evaluated from user-controlled content",
    "fix": "Never eval request data; use pattern matching or data-driven dispatch",
    "either": ["Code.eval_string($C", "Code.eval($C"],
    "mvr": { "C": "[Uu]ser|[Ii]nput|[Ff]ormat|[Qq]uery|[Pp]aram|[Rr]equest" },
    "metadata": { "owasp": "A03:2021-Injection", "cwe": "CWE-95", "confidence": "HIGH" },
    "fail": "Code.eval_string(userInput)",
    "pass": "Code.eval_string(\"1 + 1\")"
  },
  {
    "id": "elixir-unsafe-term-decode",
    "group": "security",
    "languages": ["elixir"],
    "severity": "ERROR",
    "category": "security:deserialization",
    "message": "binary_to_term on untrusted data (unsafe Erlang term decoding)",
    "fix": "Use :erlang.binary_to_term(bin, [:safe]) or an explicit allowlisted format",
    "pattern": ":erlang.binary_to_term($D",
    "mvr": { "D": "[Rr]esponse|[Nn]etwork|[Rr]equest|[Uu]ntrusted|[Ss]ocket|[Pp]ayload|[Bb]ody" },
    "metadata": { "owasp": "A08:2021-Integrity-Failure", "cwe": "CWE-502", "confidence": "HIGH" },
    "fail": "term = :erlang.binary_to_term(responsePayload)",
    "pass": "term = :erlang.binary_to_term(localBytes, [:safe])"
  },
  {
    "id": "elixir-sql-string-interpolation",
    "group": "security",
    "languages": ["elixir"],
    "severity": "ERROR",
    "category": "security:owasp-a1-injection",
    "message": "SQL built with string interpolation (SQL injection)",
    "fix": "Use Ecto parameterized queries with ? / $n placeholders",
    "either": ["query($Q", "execute($Q"],
    "mvr": { "Q": "[Ff]ormat|[Uu]ser|[Ii]nput|[Pp]aram|[Qq]uery|\\+|interpolat|#\\{" },
    "metadata": { "owasp": "A03:2021-Injection", "cwe": "CWE-89", "confidence": "HIGH" },
    "fail": "Ecto.Adapters.SQL.query(Repo, \"SELECT * FROM users WHERE id = #{id}\", [])",
    "pass": "Ecto.Adapters.SQL.query(Repo, \"SELECT * FROM accounts WHERE id = $1\", [])"
  },
  {
    "id": "elixir-open-redirect-user-input",
    "group": "security",
    "languages": ["elixir"],
    "severity": "ERROR",
    "category": "security:open-redirect",
    "message": "Redirect target taken from user-controlled data (open redirect)",
    "fix": "Resolve the target against an allowlist of local paths",
    "pattern": "redirect(conn, $URL",
    "mvr": { "URL": "[Uu]ser|[Ii]nput|[Qq]uery|[Pp]aram|[Nn]ext|[Ff]rom" },
    "metadata": { "owasp": "A01:2021-Broken-Access-Control", "cwe": "CWE-601", "confidence": "HIGH" },
    "fail": "redirect(conn, to: params[\"next\"])",
    "pass": "redirect(conn, to: \"/dashboard\")"
  },
  {
    "id": "elixir-ssrf-user-input",
    "group": "security",
    "languages": ["elixir"],
    "severity": "ERROR",
    "category": "security:owasp-a10-ssrf",
    "message": "HTTP request URL taken from user-controlled data (SSRF)",
    "fix": "Validate the URL against an allowlist of hosts/schemes",
    "either": ["HTTPoison.get($URL", "Tesla.get($URL", "Finch.get($URL"],
    "mvr": { "URL": "[Uu]ser|[Ii]nput|[Qq]uery|[Pp]aram|[Rr]equest|[Nn]ext" },
    "metadata": { "owasp": "A10:2021-Server-Side-Request-Forgery", "cwe": "CWE-918", "confidence": "HIGH" },
    "fail": "HTTPoison.get(userUrl)",
    "pass": "HTTPoison.get(\"https://api.example.com/v1\")"
  },
  {
    "id": "elixir-html-user-input",
    "group": "security",
    "languages": ["elixir"],
    "severity": "WARNING",
    "category": "security:owasp-a3-xss",
    "message": "Raw HTML rendered from user-controlled data (XSS)",
    "fix": "Drop raw/1 or escape the value before inserting it into HTML",
    "pattern": "raw($H",
    "mvr": { "H": "[Ff]ormat|[Uu]ser|[Ii]nput|[Rr]equest|[Qq]uery|[Pp]aram" },
    "metadata": { "owasp": "A03:2021-Injection", "cwe": "CWE-79", "confidence": "HIGH" },
    "fail": "raw(\"<p>#{userBio}</p>\")",
    "pass": "raw(\"<p>Welcome</p>\")"
  },
  {
    "id": "elixir-weak-md5-sha1",
    "group": "security",
    "languages": ["elixir"],
    "severity": "WARNING",
    "category": "security:weak-crypto",
    "message": "MD5/SHA-1 hash used (broken for security purposes)",
    "fix": "Use SHA-256+ for integrity, bcrypt/scrypt/argon2 for passwords",
    "either": [":crypto.hash(:md5, $D", ":crypto.hash(:sha1, $D"],
    "metadata": { "owasp": "A02:2021-Crypto-Failures", "cwe": "CWE-327", "confidence": "MEDIUM" },
    "fail": "h = :crypto.hash(:md5, data)",
    "pass": "h = :crypto.hash(:sha256, data)"
  },
  {
    "id": "elixir-atom-exhaustion",
    "group": "security",
    "languages": ["elixir"],
    "severity": "WARNING",
    "category": "security:denial-of-service",
    "message": "New atom created from user-controlled data (atom table exhaustion)",
    "fix": "Use String.to_existing_atom/1 and handle ArgumentError",
    "pattern": "String.to_atom($S",
    "mvr": { "S": "[Uu]ser|[Ii]nput|[Qq]uery|[Pp]aram|[Rr]equest|[Hh]eader" },
    "metadata": { "owasp": "A05:2021-Security-Misconfiguration", "cwe": "CWE-400", "confidence": "MEDIUM" },
    "fail": "key = String.to_atom(userHeader)",
    "pass": "key = String.to_atom(\"active\")"
  },
  {
    "id": "elixir-user-controlled-template",
    "group": "security",
    "languages": ["elixir"],
    "severity": "ERROR",
    "category": "security:ssti",
    "message": "Template evaluated from user-controlled content (SSTI)",
    "fix": "Render fixed templates; pass user data as assigns only",
    "either": ["EEx.eval_string($T", "render_to_string($T"],
    "mvr": { "T": "[Ff]ormat|[Uu]ser|[Ii]nput|[Rr]equest|[Qq]uery|[Pp]aram" },
    "metadata": { "owasp": "A03:2021-Injection", "cwe": "CWE-1336", "confidence": "HIGH" },
    "fail": "html = EEx.eval_string(userTemplate, assigns: %{})",
    "pass": "html = EEx.eval_string(TEMPLATE, assigns: %{})"
  }
]
