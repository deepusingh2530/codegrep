[
  {
    "id": "rust-command-user-input",
    "group": "security",
    "languages": ["rust"],
    "severity": "ERROR",
    "category": "security:code-execution",
    "message": "Process spawned with a program name taken from user-controlled data",
    "fix": "Use a fixed program path and pass user data as arguments",
    "either": ["Command::new($CMD)", "Command::arg($CMD)"],
    "mvr": { "CMD": "[Uu]ser|[Ii]nput|argv|args|params|env::var" },
    "metadata": { "owasp": "A03:2021-Injection", "cwe": "CWE-78", "confidence": "HIGH" },
    "fail": "let p = Command::new(&args[1]).output()?;",
    "pass": "let p = Command::new(\"git\").arg(\"status\").output()?;"
  },
  {
    "id": "rust-untrusted-deserialization",
    "group": "security",
    "languages": ["rust"],
    "severity": "ERROR",
    "category": "security:deserialization",
    "message": "Binary deserialization of untrusted network data",
    "fix": "Validate message framing/lengths and authenticate peers before decoding",
    "either": ["bincode::from_slice($D)", "bincode::deserialize($D)", "postcard::from_bytes($D)"],
    "mvr": { "D": "[Rr]esponse|[Nn]etwork|[Rr]equest|[Uu]ntrusted|[Ss]ocket|[Ss]erver" },
    "metadata": { "owasp": "A08:2021-Integrity-Failure", "cwe": "CWE-502", "confidence": "HIGH" },
    "fail": "let v: Msg = bincode::from_slice(&response.body)?;",
    "pass": "let v: Msg = bincode::from_slice(&local_bytes)?;"
  },
  {
    "id": "rust-accept-invalid-certs",
    "group": "security",
    "languages": ["rust"],
    "severity": "ERROR",
    "category": "security:misconfig",
    "message": "TLS certificate verification disabled on an HTTPS client",
    "fix": "Drop the override; pin or properly trust the server certificate chain",
    "either": ["danger_accept_invalid_certs(true)", "danger_accept_invalid_hostnames(true)"],
    "metadata": { "owasp": "A05:2021-Security-Misconfiguration", "cwe": "CWE-295", "confidence": "HIGH" },
    "fail": "let client = reqwest::Client::builder().danger_accept_invalid_certs(true).build()?;",
    "pass": "let client = reqwest::Client::builder().danger_accept_invalid_certs(false).build()?;"
  },
  {
    "id": "rust-open-redirect-user-input",
    "group": "security",
    "languages": ["rust"],
    "severity": "ERROR",
    "category": "security:open-redirect",
    "message": "Redirect target taken from user-controlled data (open redirect)",
    "fix": "Resolve the target against an allowlist of local paths",
    "pattern": "Redirect::to($URL)",
    "mvr": { "URL": "[Qq]uery|[Rr]equest|[Ii]nput|[Uu]ser|[Pp]aram|[Nn]ext|[Ff]rom" },
    "metadata": { "owasp": "A01:2021-Broken-Access-Control", "cwe": "CWE-601", "confidence": "HIGH" },
    "fail": "return Redirect::to(&query_params[\"next\"]);",
    "pass": "return Redirect::to(\"/dashboard\");"
  },
  {
    "id": "rust-sql-string-interpolation",
    "group": "security",
    "languages": ["rust"],
    "severity": "ERROR",
    "category": "security:owasp-a1-injection",
    "message": "SQL built with string interpolation/concatenation (SQL injection)",
    "fix": "Use bound parameters (e.g. stmt.execute([param])) instead of formatting SQL",
    "either": ["conn.execute($Q)", "db.execute($Q)", "sqlx::query($Q)"],
    "mvr": { "Q": "format!|push_str|concat!|\\+" },
    "metadata": { "owasp": "A03:2021-Injection", "cwe": "CWE-89", "confidence": "HIGH" },
    "fail": "conn.execute(&format!(\"SELECT * FROM users WHERE id={}\", uid))?;",
    "pass": "conn.execute(\"SELECT * FROM users WHERE id=?1\", &[&uid])?;"
  },
  {
    "id": "rust-ssrf-user-input",
    "group": "security",
    "languages": ["rust"],
    "severity": "ERROR",
    "category": "security:owasp-a10-ssrf",
    "message": "HTTP request URL taken from user-controlled data (SSRF)",
    "fix": "Validate the URL against an allowlist of hosts/schemes",
    "pattern": "reqwest::get($URL)",
    "mvr": { "URL": "[Uu]ser|[Ii]nput|[Qq]uery|[Pp]aram|[Rr]equest|[Nn]ext|[Ff]rom|args" },
    "metadata": { "owasp": "A10:2021-Server-Side-Request-Forgery", "cwe": "CWE-918", "confidence": "HIGH" },
    "fail": "let r = reqwest::get(&user_supplied_url).await?;",
    "pass": "let r = reqwest::get(\"https://api.example.com/v1\").await?;"
  },
  {
    "id": "rust-user-controlled-template",
    "group": "security",
    "languages": ["rust"],
    "severity": "ERROR",
    "category": "security:ssti",
    "message": "Template rendered from user-controlled content (SSTI)",
    "fix": "Render fixed template names; pass user data as context values only",
    "either": ["one_off($T,", "render_template($T,"],
    "mvr": { "T": "format!|[Uu]ser|[Ii]nput|[Rr]equest|[Qq]uery|[Pp]aram" },
    "metadata": { "owasp": "A03:2021-Injection", "cwe": "CWE-1336", "confidence": "HIGH" },
    "fail": "let html = tera.one_off(&format!(\"{}\", user_tpl), &ctx, true)?;",
    "pass": "let html = tera.one_off(TEMPLATE, &ctx, true)?;"
  },
  {
    "id": "rust-html-user-input",
    "group": "security",
    "languages": ["rust"],
    "severity": "WARNING",
    "category": "security:owasp-a3-xss",
    "message": "HTML response built from user-controlled data (XSS)",
    "fix": "Escape the value (askama/maud auto-escape) or template it",
    "pattern": "Html($X)",
    "mvr": { "X": "format!|[Uu]ser|[Ii]nput|[Rr]equest|[Qq]uery|[Pp]aram" },
    "metadata": { "owasp": "A03:2021-Injection", "cwe": "CWE-79", "confidence": "HIGH" },
    "fail": "return Html(format!(\"<p>{}</p>\", user_bio));",
    "pass": "return Html(\"<p>Welcome</p>\");"
  },
  {
    "id": "rust-weak-md5-sha1",
    "group": "security",
    "languages": ["rust"],
    "severity": "WARNING",
    "category": "security:weak-crypto",
    "message": "MD5/SHA-1 hash used (broken for security purposes)",
    "fix": "Use SHA-256+ for integrity, bcrypt/scrypt/argon2 for passwords",
    "either": ["Md5::new(", "md5::compute($D)", "Sha1::new(", "sha1::digest($D)"],
    "metadata": { "owasp": "A02:2021-Crypto-Failures", "cwe": "CWE-327", "confidence": "MEDIUM" },
    "fail": "let mut h = Md5::new();",
    "pass": "let mut h = Sha256::new();"
  },
  {
    "id": "rust-weak-cipher",
    "group": "security",
    "languages": ["rust"],
    "severity": "WARNING",
    "category": "security:weak-crypto",
    "message": "Obsolete cipher (DES/3DES/RC4) in use",
    "fix": "Use AES-GCM or ChaCha20-Poly1305",
    "either": ["DES::new($K)", "TDES::new($K)", "Rc4::new("],
    "metadata": { "owasp": "A02:2021-Crypto-Failures", "cwe": "CWE-327", "confidence": "MEDIUM" },
    "fail": "let c = DES::new(&key)?;",
    "pass": "let c = Aes256::new(&key)?;"
  }
]
