[
  {
    "id": "swift-command-user-input",
    "group": "security",
    "languages": ["swift"],
    "severity": "ERROR",
    "category": "security:code-execution",
    "message": "Process launched with a program/path taken from user-controlled data",
    "fix": "Use a fixed executable path and pass user data as arguments",
    "either": ["executableURL = $P", "launchPath = $P"],
    "mvr": { "P": "[Uu]ser|[Ii]nput|[Aa]rgs|[Pp]arams?|[Qq]uery" },
    "metadata": { "owasp": "A03:2021-Injection", "cwe": "CWE-78", "confidence": "HIGH" },
    "fail": "p.executableURL = URL(string: userInput)",
    "pass": "p.executableURL = URL(fileURLWithPath: \"/bin/ls\")"
  },
