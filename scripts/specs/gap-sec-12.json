    "group": "tsgap1",
    "fail": "const token = jwt.sign({ id: user.id }, \"supersecretkey123\");\n",
    "pass": "const token = jwt.sign({ id: user.id }, process.env.JWT_SECRET);\n"
  },
  {
    "id": "ts-jwt-none-alg",
    "languages": ["typescript"],
    "severity": "ERROR",
    "category": "security:owasp-a2-crypto",
    "message": "JWT verify allows the 'none' algorithm (signature bypass)",
    "fix": "Pin the allowed algorithms to the expected HMAC/RSA ones",
    "either": ["jwt.verify($T, $K, $OPTS)", "algorithms: [\"none\"]"],
    "mvr": {"OPTS": "algorithms.*none"},
    "metadata": {"owasp": "A07:2021-Identification-Auth", "cwe": "CWE-287", "confidence": "HIGH"},
    "group": "tsgap1",
    "fail": "const d = jwt.verify(token, key, { algorithms: [\"none\"] });\n",
    "pass": "const d = jwt.verify(token, key, { algorithms: [\"HS256\"] });\n"
  },
