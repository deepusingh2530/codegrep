[
  {
    "id": "ts-hardcoded-jwt-secret",
    "languages": ["typescript"],
    "severity": "ERROR",
    "category": "security:secrets",
    "message": "JWT signed with a hard-coded literal secret",
    "fix": "Load the signing secret from the environment or a KMS",
    "either": ["jwt.sign($P, \"", "jwt.sign($P, '"],
