  {
    "id": "ts-redos-new-regexp",
    "languages": ["typescript"],
    "severity": "WARNING",
    "category": "security:denial-of-service",
    "message": "RegExp built from request input (ReDoS via catastrophic backtracking)",
    "fix": "Constrain the pattern, cap input length, or use a linear-time engine",
    "pattern": "new RegExp($PAT)",
    "mvr": {"PAT": "req\\.|params"},
