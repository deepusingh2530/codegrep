  },
  {
    "id": "sql-into-outfile",
    "group": "security",
    "languages": ["sql"],
    "severity": "ERROR",
    "category": "security:owasp-a1-injection",
    "message": "SELECT INTO OUTFILE/DUMPFILE writes server files (SQLi impact)",
    "fix": "Remove FILE privilege; export through controlled application code",
    "either": ["INTO OUTFILE $F", "INTO DUMPFILE $F"],
    "mvr": { "F": "'.+'" },
