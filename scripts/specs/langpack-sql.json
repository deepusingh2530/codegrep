[
  {
    "id": "sql-hardcoded-password",
    "group": "security",
    "languages": ["sql"],
    "severity": "ERROR",
    "category": "security:secrets",
    "message": "CREATE USER with a hardcoded password literal",
    "fix": "Use a parameterized/secret-managed password or external auth",
    "either": ["IDENTIFIED BY $PW"],
    "mvr": { "PW": "'.+'" },
    "metadata": { "owasp": "A07:2021-Identification-Auth", "cwe": "CWE-798", "confidence": "HIGH" },
    "fail": "CREATE USER bob IDENTIFIED BY 'hunter2';",
    "pass": "CREATE USER bob IDENTIFIED BY :password;"
  },
  {
    "id": "sql-grant-all-public",
    "group": "security",
    "languages": ["sql"],
    "severity": "WARNING",
    "category": "security:misconfig",
    "message": "ALL PRIVILEGES granted to PUBLIC or any-host account",
    "fix": "Grant least-privilege rights to a specific role/account",
    "pattern": "GRANT ALL PRIVILEGES ON $O TO $T",
    "mvr": { "T": "PUBLIC|'%'|ALL USERS" },
    "metadata": { "owasp": "A01:2021-Broken-Access-Control", "cwe": "CWE-269", "confidence": "MEDIUM" },
    "fail": "GRANT ALL PRIVILEGES ON *.* TO PUBLIC;",
    "pass": "GRANT ALL PRIVILEGES ON app.orders TO 'orders_rw';"
  },
  {
    "id": "sql-dynamic-sql-concat",
    "group": "security",
    "languages": ["sql"],
    "severity": "ERROR",
    "category": "security:owasp-a1-injection",
    "message": "Dynamic SQL statement built by concatenation (SQL injection)",
    "fix": "Use parameterized statements / sp_executesql with bind variables",
    "either": ["EXECUTE IMMEDIATE $Q", "EXEC($Q"],
    "mvr": { "Q": "[Uu]ser|[Ii]nput|[Pp]aram|\\+" },
    "metadata": { "owasp": "A03:2021-Injection", "cwe": "CWE-89", "confidence": "HIGH" },
    "fail": "EXEC('SELECT * FROM users WHERE id=' + @uid);",
    "pass": "EXEC(N'SELECT * FROM accounts WHERE id = @id');"
  },
  {
    "id": "sql-xp-cmdshell",
    "group": "security",
    "languages": ["sql"],
    "severity": "ERROR",
    "category": "security:code-execution",
    "message": "xp_cmdshell enabled/invoked (OS command execution from SQL)",
    "fix": "Disable xp_cmdshell; use external job runners for OS tasks",
    "pattern": "xp_cmdshell $CMD",
